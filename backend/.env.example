# =========================================================
# Variables de entorno del backend (Node.js / Express)
# Copiar este archivo a `.env` y reemplazar los valores.
# Nunca subir el `.env` real al repositorio.
# =========================================================

# Puerto del servidor Express
PORT=5000

# Cadena de conexión a PostgreSQL
# Local:  postgres://usuario:contrasena@localhost:5432/hotel_laureles
# Nube:   postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:contrasena@localhost:5432/hotel_laureles

# Activar SSL si el proveedor lo exige (Neon, Railway, Render, etc.)
# DATABASE_SSL=true

# Secretos de los tokens JWT (usar valores largos y distintos)
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-para-access
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-para-refresh

# Tiempos de vigencia de los tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Número de rondas de bcrypt para el hash de contraseñas
BCRYPT_ROUNDS=10

# Origen permitido por CORS (URL del frontend)
CORS_ORIGIN=http://localhost:3000

# Datos del primer administrador (solo para `npm run seed:admin`)
SEED_ADMIN_NOMBRE=admin
SEED_ADMIN_CORREO=admin@hotel.local
SEED_ADMIN_PASSWORD=cambiar-esta-contrasena
