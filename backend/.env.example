# Variables de entorno del backend (Node.js / Express)
#
# Copiar este fichero a `.env` y rellenar los valores.
#
# ```bash
# # Puerto en el que escucha el servidor Express
# PORT=5000
#
# # Cadena de conexión a PostgreSQL.
# # Ejemplo local:
# #   postgres://usuario:contrasena@localhost:5432/hotel_laureles
# # Ejemplo Neon/Railway/Render:
# #   postgres://<user>:<password>@<host>:<port>/<database>
# DATABASE_URL=postgres://localhost:5432/hotel_laureles
#
# # Secreto para firmar los tokens JWT (cambiar en entorno de producción)
# JWT_SECRET=hotel-los-laureles-secret
# JWT_EXPIRES_IN=7d
# ```

# Puerto en el que escucha el servidor Express
PORT=5000

# Cadena de conexión a PostgreSQL.
# Ejemplo local:
#   postgres://usuario:contrasena@localhost:5432/hotel_laureles
# Ejemplo Neon/Railway/Render:
#   postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://localhost:5432/hotel_laureles

# Secreto para firmar los tokens JWT (cambiar en entorno de producción)
JWT_SECRET=hotel-los-laureles-secret
JWT_EXPIRES_IN=7d
