# Variables de entorno del backend (Node.js / Express)
#
# Copiar este fichero a `.env` y rellenar los valores.
# `.env` NO debe subirse al repositorio.

# Puerto en el que escucha el servidor Express
PORT=5000

# Cadena de conexión a PostgreSQL.
# Ejemplo local:
#   postgres://usuario:contrasena@localhost:5432/hotel_laureles
# Ejemplo Neon/Railway/Render:
#   postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://localhost:5432/hotel_laureles

# Si el proveedor exige SSL, poner DATABASE_SSL=true
DATABASE_SSL=false

# ------------------ JWT ------------------
# IMPORTANTE: usar secretos DISTINTOS para access y refresh.
# Genera valores aleatorios largos, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto-de-access
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh

# Vida del access token y del refresh token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Emisor y audiencia de los tokens
JWT_ISSUER=hotel-laureles
JWT_AUDIENCE=hotel-laureles-web

# ------------------ bcrypt ------------------
BCRYPT_SALT_ROUNDS=10

# ------------------ Seed del primer administrador ------------------
# Se usan con: npm run seed:admin
SEED_ADMIN_USERNAME=admin.laureles
SEED_ADMIN_EMAIL=admin@laureles.com
SEED_ADMIN_PASSWORD=cambia-esta-contrasena
