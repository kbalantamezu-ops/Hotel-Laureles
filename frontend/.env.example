# Frontend (.env.example) - Hotel Los Laureles
#
# Copiar a .env.local y ajustar según el entorno.
# .env.local NO debe subirse al repositorio.
#
# La autenticación usa JWT:
#   - access token corto + refresh token
#   - se guardan en localStorage desde el navegador
#   - el cliente HTTP renueva el access ante un 401
#
# No hay secretos JWT en el frontend: la firma y validación
# ocurren únicamente en el backend.

# URL base pública de la API (la usa el navegador)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# URL de la API usada por el proxy interno de Next.js (opcional).
# Si no se define, se usa NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=http://localhost:5000/api

# Puerto del frontend en desarrollo (opcional)
PORT=3000
