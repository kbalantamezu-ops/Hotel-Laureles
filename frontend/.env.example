# Frontend (.env.example) - Hotel Los Laureles
#
# Este es el archivo de plantilla del repositorio.
# Se copia a .env.local y se rellenan los valores según el entorno.
#
# .env.local NO debe subirse al repositorio.
#
# Cómo usar este proyecto:
#   1. Copia este archivo a .env.local:
#        cp .env.example .env.local
#   2. Ajusta NEXT_PUBLIC_API_URL si el backend está en otro puerto/dominio.
#   3. El frontend ya tiene un API route de proxy en src/app/api/
#      para que las peticiones a /api/* lleguen al backend sin problemas
#      de origen en el navegador.

# URL base de la API del backend
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Puerto del frontend en desarrollo (opcional)
PORT=3000

# Opcional: si el frontend está en otro dominio, añade el origin
# para que el backend pueda recibir las peticiones desde el navegador.
# NEXT_PUBLIC_FRONTEND_ORIGIN=http://localhost:3000
